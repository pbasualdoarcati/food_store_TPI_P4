# Base de datos. Para desarrollo local alcanza con SQLite:
DATABASE_URL=sqlite:///./foodstore.db
# Alternativa PostgreSQL (crear antes la base foodstore_db):
# DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración del token y de la cookie (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
